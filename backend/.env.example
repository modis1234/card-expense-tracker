# Database
DATABASE_URL="postgresql://user:password@localhost:5432/card_expense_tracker"
# 로컬 PostgreSQL(SSL 미사용)이면 false, Supabase는 생략
DB_SSL=false

# JWT
JWT_SECRET="your-secret-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Gemini AI (카테고리 자동 분류)
GEMINI_API_KEY="your-gemini-api-key"
USE_AI_CATEGORIZATION=true

# Server
PORT=3000
NODE_ENV=development

# Google OAuth (Gmail 읽기 권한 포함)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Frontend (설정 시 Google 로그인 후 {FRONTEND_URL}/auth/callback#token=... 으로 리디렉션)
FRONTEND_URL="http://localhost:3001"
