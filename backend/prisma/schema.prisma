generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  password          String?
  name              String?
  googleId          String?        @unique
  picture           String?
  provider          String?        @default("local")
  gmailAccessToken  String?
  gmailRefreshToken String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  files             File[]
  transactions      Transaction[]
  feedbacks         UserFeedback[]
  cards             Card[]
  cardGroups        CardGroup[]

  @@map("users")
}

model CardCompany {
  id           String        @id @default(uuid())
  name         String        @unique
  code         String        @unique
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  files        File[]
  transactions Transaction[]
  cards        Card[]

  @@map("card_companies")
}

model CardGroup {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards     Card[]

  @@unique([userId, name])
  @@map("card_groups")
}

model Card {
  id            String        @id @default(uuid())
  userId        String
  cardCompanyId String
  last4         String
  alias         String?
  groupId       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardCompany   CardCompany   @relation(fields: [cardCompanyId], references: [id])
  group         CardGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  transactions  Transaction[]

  @@unique([userId, cardCompanyId, last4])
  @@index([groupId])
  @@map("cards")
}

model Category {
  id           String         @id @default(uuid())
  name         String
  icon         String
  color        String
  order        Int
  isActive     Boolean        @default(true)
  parentId     String?
  parent       Category?      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]     @relation("CategoryTree")
  transactions Transaction[]
  newFeedbacks UserFeedback[] @relation("NewCategory")
  oldFeedbacks UserFeedback[] @relation("OldCategory")

  @@index([parentId])
  @@index([isActive, order])
  @@map("categories")
}

model Transaction {
  id                String         @id @default(uuid())
  date              DateTime       @db.Date
  amount            Int
  /// 할부 개월 수 (일시불이면 null)
  installmentMonths Int?
  /// 이번 명세서의 할부 회차
  installmentRound  Int?
  /// 명세서 원래 이용금액 (amount와 다를 때만: 할부 전체 금액, 할인·부분취소 전 금액)
  originalAmount    Int?
  /// 청구월 'YYYY-MM' (하나카드 명세서 이용기간 종료월, 없으면 이용일 기준으로 집계)
  billingMonth      String?
  description       String?
  confidence        Decimal?       @db.Decimal(3, 2)
  cardCompanyId     String
  cardId            String?
  categoryId        String
  createdAt         DateTime       @default(now())
  fileId            String?
  merchantName      String
  needsReview       Boolean        @default(false)
  updatedAt         DateTime       @updatedAt
  userId            String
  cardCompany       CardCompany    @relation(fields: [cardCompanyId], references: [id])
  card              Card?          @relation(fields: [cardId], references: [id], onDelete: SetNull)
  category          Category       @relation(fields: [categoryId], references: [id])
  file              File?          @relation(fields: [fileId], references: [id])
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedbacks         UserFeedback[]

  @@index([userId, date(sort: Desc)])
  @@index([categoryId])
  @@index([cardCompanyId])
  @@index([cardId])
  @@index([userId, categoryId, date])
  @@index([needsReview])
  @@map("transactions")
}

model File {
  id            String        @id @default(uuid())
  filename      String
  status        String        @default("completed")
  cardCompanyId String
  fileSize      Int
  fileUrl       String
  originalName  String
  uploadedAt    DateTime      @default(now())
  userId        String
  cardCompany   CardCompany   @relation(fields: [cardCompanyId], references: [id])
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@index([userId, uploadedAt(sort: Desc)])
  @@index([cardCompanyId])
  @@map("files")
}

model UserFeedback {
  id            String      @id @default(uuid())
  createdAt     DateTime    @default(now())
  merchantName  String
  newCategoryId String
  oldCategoryId String
  transactionId String
  userId        String
  newCategory   Category    @relation("NewCategory", fields: [newCategoryId], references: [id])
  oldCategory   Category    @relation("OldCategory", fields: [oldCategoryId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([merchantName])
  @@index([userId, createdAt(sort: Desc)])
  @@map("user_feedbacks")
}
